{%- comment -%}
  An image with an optional caption. Same parameters as the old al-folio include:
  {% include figure.liquid path="assets/img/x.jpg" class="img-fluid rounded z-depth-1"
     alt="..." caption="..." title="..." loading="lazy" zoomable=true %}
  "zoomable" makes the picture a link to the full-size image.
{%- endcomment -%}
{%- assign src = include.path | relative_url -%}
<figure class="figure">
  {%- if include.zoomable %}<a href="{{ src }}" class="zoom">{% endif -%}
  <img src="{{ src }}"
    {%- if include.class %} class="{{ include.class }}"{% endif %}
    alt="{{ include.alt | default: include.caption | strip_html | escape }}"
    {%- if include.title %} title="{{ include.title | escape }}"{% endif %}
    {%- if include.width %} width="{{ include.width }}"{% endif %}
    {%- if include.height %} height="{{ include.height }}"{% endif %}
    loading="{{ include.loading | default: 'lazy' }}">
  {%- if include.zoomable %}</a>{% endif -%}
  {%- if include.caption %}
  <figcaption class="caption">{{ include.caption }}</figcaption>
  {%- endif %}
</figure>
