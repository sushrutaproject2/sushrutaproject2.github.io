source "https://rubygems.org"

gem "jekyll", "~> 4.4"

group :jekyll_plugins do
  gem "jekyll-scholar", "~> 7.2"   # citations and bibliographies from .bib files
  gem "jekyll-archives", "~> 2.3"  # /blog/tag/<tag>/ and /blog/<year>/ pages
  gem "jekyll-feed"                # /feed.xml for RSS readers
  gem "jekyll-sitemap"             # /sitemap.xml for search engines
  gem "jekyll-seo-tag"             # page titles and descriptions in <head>
end

# Needed by Ruby 3.4+, no longer bundled with Ruby itself
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "observer"
